# Frontend Environment Configuration
# If frontend is hosted separately from backend (e.g. Vercel, Netlify, Live Server),
# set your backend API and WebSocket server URLs below.

# Backend HTTP Base URL (leave empty to use current host)
VITE_API_BASE_URL=http://localhost:3000

# Backend WebSocket Base URL
VITE_WS_BASE_URL=ws://localhost:3000
